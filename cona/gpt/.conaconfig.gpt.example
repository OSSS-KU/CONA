{
  "model": {
    "name": "gpt-example",
    "layers": 24,
    "hidden": 2048,
    "ffn_hidden": 8192,
    "heads": 16,
    "seq": 1024,
    "attention_dropout": 0.1,
    "hidden_dropout": 0.1,
    "normalization": "layernorm",
    "layernorm_epsilon": 1e-5
  },
  "training": {
    "wandb_project": "gpt-example",
    "zero_stage": 1,
    "dtype": "fp16",
    "base_gbs": 8,
    "base_lr": 3e-4,
    "base_min_lr": 2e-4,
    "scale_min_lr": false,
    "lr_scale_strategy": "linear",
    "lr_scale_lr_cap": 0.0,
    "fallback": false,
    "fallback_ema_alpha": 0.1,
    "fallback_patience": 100,
    "lr_decay_tokens": 414171136,
    "lr_warmup_frac": 0.01,
    "weight_decay": 0.01,
    "log_interval": 1,
    "eval_interval": 100,
    "eval_iters": 100,
    "split": "98,2,0",
    "data_prefix": "wikitext103_gpt_text_document",
    "vocab_file": "vocab.json",
    "merge_file": "merges.txt",
    "tokenizer_type": "GPT2BPETokenizer",
    "data_cache_path": "index-cache",
    "wandb_mode": "offline",
    "distributed_timeout_minutes": 120,
    "wandb_dir": "/workspace/wandb",
    "log_root": "/workspace/logs"
  }
}
